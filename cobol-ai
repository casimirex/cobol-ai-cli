#!/bin/bash
# COBOL AI CLI Wrapper Script
# Sources .env file and exports environment variables before running the COBOL program

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ENV_FILE="${SCRIPT_DIR}/.env"

# Load environment variables from .env file if it exists
if [[ -f "$ENV_FILE" ]]; then
    set -a
    source "$ENV_FILE"
    set +a
fi

# Run the COBOL program with all arguments
exec "${SCRIPT_DIR}/cobol-ai.bin" "$@"
