# COBOL AI CLI - Environment Configuration
# Copy this file to .env and fill in your values

# AI Provider (currently only 'ollama' supported)
AI_PROVIDERS=ollama

# Ollama API Key (get from https://ollama.com/settings/keys)
AI_OLLAMA_API_KEY=your_api_key_here

# Ollama API Base URL
AI_OLLAMA_BASE_URL=https://ollama.com

# Default Model (see https://ollama.com/models for available models)
AI_OLLAMA_DEFAULT_MODEL=gpt-oss:120b

# Request Timeout in milliseconds
AI_OLLAMA_TIMEOUT=60000